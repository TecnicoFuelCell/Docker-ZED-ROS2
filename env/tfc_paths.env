# env/tfc_paths.env — single source of truth for all runtime paths.
# TFC_ROOT is the only absolute value and can be overridden externally,
# so the same file works on the Jetson (/opt/tfc-autonomous), a laptop, or CI.
# setup_jetson.py replaces @TFC_ROOT@ with the machine value and writes the
# runtime copy to /opt/tfc-autonomous/config/tfc_paths.env.
export TFC_ROOT="${TFC_ROOT:-@TFC_ROOT@}"

# config
export TFC_CONFIG_DIR="${TFC_ROOT}/config"
export TFC_PARAMS_DIR="${TFC_CONFIG_DIR}/params"
export TFC_CAMERA_DIR="${TFC_CONFIG_DIR}/camera"
export TFC_MAPS_DIR="${TFC_CONFIG_DIR}/maps"
export TFC_VESC_DIR="${TFC_CONFIG_DIR}/vesc"

# data
export TFC_DATA_DIR="${TFC_ROOT}/data"
export TFC_ROSBAG_DIR="${TFC_DATA_DIR}/rosbags"
export TFC_LOG_DIR="${TFC_DATA_DIR}/logs"
export TFC_MODELS_DIR="${TFC_DATA_DIR}/models"
export TFC_SNAPSHOT_DIR="${TFC_DATA_DIR}/snapshots"

#!/usr/bin/env bash
# Unified CLI for the tfc-autonomous Jetson container.
#
# Sourcing strategy: the machine env file (generated by setup_jetson.py) is
# sourced on demand by every command, so container/project/workspace names are
# resolved from it and nothing here is hard-coded. A per-member override can be
# applied with --member <path> (or JETSON_MEMBER_ENV).
#
# Usage:
#   jetson docker build       build the image from this repo's Dockerfile
#   jetson docker up          create/start the container (compose up -d)
#   jetson docker up --build  build then start
#   jetson docker stop        stop the container (kept, restartable)
#   jetson docker down        stop and remove the container
#   jetson docker rm          force-remove the container
#   jetson docker enter       enter the container with X11 forwarding
#   jetson docker ps          show container status
#   jetson docker logs        tail the container logs
#   jetson env                print the sourced TFC_* variables
#   jetson bootstrap          link onto PATH + install TFC env sourcing (idempotent)
#   jetson help
#
# The script can also be sourced (`source jetson`), which exposes the `jetson`
# function in your shell.

if [[ "${BASH_SOURCE[0]}" == "$0" ]]; then
    set -euo pipefail
fi

# Resolve the real script location (works when invoked through a symlink on
# PATH, e.g. /usr/local/bin/jetson -> <repo>/jetson). The canonical docker dir
# is overridden from the env file via TFC_DOCKER_DIR once setup_jetson.py has run.
JETSON_SRC="$(readlink -f "${BASH_SOURCE[0]}")"
JETSON_REPO_DIR="$(cd "$(dirname "$JETSON_SRC")" && pwd)"
JETSON_ENV_FILE="${JETSON_ENV_FILE:-/opt/tfc-autonomous/config/tfc_paths.env}"
JETSON_COMPOSE_FILE="$JETSON_REPO_DIR/docker-compose.yml"

_jetson_load_env() {
    if [[ ! -f "$JETSON_ENV_FILE" ]]; then
        echo "jetson: error: $JETSON_ENV_FILE missing - run jetson-setup/setup_jetson.py first" >&2
        return 1
    fi
    set -a
    source "$JETSON_ENV_FILE"
    if [[ -n "${JETSON_MEMBER_ENV:-}" ]]; then
        if [[ ! -f "$JETSON_MEMBER_ENV" ]]; then
            echo "jetson: error: member env $JETSON_MEMBER_ENV missing" >&2
            return 1
        fi
        source "$JETSON_MEMBER_ENV"
    fi
    set +a
    export TFC_PROJECT="${TFC_PROJECT:-tfc-autonomous}"
    export TFC_CONTAINER_NAME="${TFC_CONTAINER_NAME:-tfc-autonomous}"
    export TFC_WS="${TFC_WS:-${TFC_REPOSITORIES_DIR:-}/Autonomous_Systems/ros2_ws}"
    export TFC_DOCKER_DIR="${TFC_DOCKER_DIR:-$JETSON_REPO_DIR}"
    JETSON_COMPOSE_FILE="$TFC_DOCKER_DIR/docker-compose.yml"
}

jetson_docker_build() {
    _jetson_load_env || return 1
    docker compose -f "$JETSON_COMPOSE_FILE" build "$@"
}

jetson_docker_up() {
    _jetson_load_env || return 1
    docker compose -f "$JETSON_COMPOSE_FILE" up -d "$@"
}

jetson_docker_stop() {
    _jetson_load_env || return 1
    docker compose -f "$JETSON_COMPOSE_FILE" stop "$@"
}

jetson_docker_down() {
    _jetson_load_env || return 1
    docker compose -f "$JETSON_COMPOSE_FILE" down "$@"
}

jetson_docker_rm() {
    _jetson_load_env || return 1
    docker rm -f "$TFC_CONTAINER_NAME"
}

jetson_docker_ps() {
    _jetson_load_env || return 1
    docker compose -f "$JETSON_COMPOSE_FILE" ps "$@"
}

jetson_docker_logs() {
    _jetson_load_env || return 1
    docker compose -f "$JETSON_COMPOSE_FILE" logs -f "$@"
}

# Enter the container with X11 support. Local GUI sessions are covered by the
# compose mounts (DISPLAY, /tmp/.X11-unix, $HOME/.Xauthority); for SSH X11
# forwarding the forwarded cookie is extracted and copied into the container.
# The xauth file is per-user (permissions) and per-invocation inside the
# container, so concurrent members with different DISPLAY values don't collide.
jetson_docker_enter() {
    _jetson_load_env || return 1
    local container="$TFC_CONTAINER_NAME"
    local state
    if ! docker ps --format '{{.Names}}' | grep -qx "$container"; then
        state="$(docker inspect -f '{{.State.Status}}' "$container" 2>/dev/null || echo missing)"
        if [[ "$state" == "restarting" ]]; then
            echo "jetson: container '$container' is restarting - check 'jetson docker logs' for the crash reason" >&2
            echo "jetson: a common cause is a missing 'install/setup.bash' in the workspace; run 'ros_build' inside the container" >&2
            return 1
        fi
        echo "jetson: container '$container' is not running ($state) - start it with 'jetson docker up'" >&2
        return 1
    fi
    if [[ -z "${DISPLAY:-}" ]]; then
        echo "jetson: DISPLAY is not set - cannot forward X11" >&2
        return 1
    fi
    local xauth="/tmp/.docker.xauth.$(id -u)"
    local remote_xauth="/tmp/.Xauthority.$$"
    local cookie
    cookie="$(xauth list "$DISPLAY" 2>/dev/null | awk '{print $3}')"
    if [[ -z "$cookie" ]]; then
        echo "jetson: could not extract X11 cookie - is DISPLAY='$DISPLAY' valid?" >&2
        echo "jetson: hint: if 'xauth list $DISPLAY' is empty, run 'xauth list' and check" >&2
        echo "jetson: that ~/.Xauthority is writable (not root-owned); fix with:" >&2
        echo "jetson:   sudo chown \$(id -u):\$(id -g) ~/.Xauthority" >&2
        return 1
    fi
    (umask 077 && touch "$xauth")
    xauth -f "$xauth" remove "$DISPLAY" >/dev/null 2>&1 || true
    xauth -f "$xauth" add "$DISPLAY" . "$cookie"
    docker cp "$xauth" "$container:$remote_xauth"
    local env_args=()
    while IFS= read -r line; do
        env_args+=(-e "$line")
    done < <(env | grep '^TFC_' || true)
    exec docker exec -it "${env_args[@]}" \
        -e DISPLAY="$DISPLAY" \
        -e XAUTHORITY="$remote_xauth" \
        "$container" bash
}

jetson_env() {
    _jetson_load_env || return 1
    env | grep '^TFC_' | sort
}

# Echo "sudo" when elevation is needed, empty when already root.
_jetson_elev() {
    if [[ "$(id -u)" -eq 0 ]]; then
        echo ""
    elif command -v sudo >/dev/null 2>&1; then
        echo "sudo"
    else
        return 1
    fi
}

# Idempotently put `jetson` on the system PATH and install the system-wide
# TFC env sourcing. The canonical docker dir comes from the env file
# (TFC_DOCKER_DIR, generated by setup_jetson.py); it falls back to the script's
# own resolved location when the env file is not present yet. Re-run after
# setup_jetson.py whenever the manifest changes.
jetson_bootstrap() {
    _jetson_load_env || true
    local elev
    elev="$(_jetson_elev)" || {
        echo "jetson: error: not root and sudo unavailable" >&2
        return 1
    }
    local docker_dir="${TFC_DOCKER_DIR:-$JETSON_REPO_DIR}"
    local script="$docker_dir/jetson"
    if [[ ! -f "$script" ]]; then
        echo "jetson: error: no $script - clone this repo to TFC_DOCKER_DIR first" >&2
        return 1
    fi

    local link=/usr/local/bin/jetson
    if [[ -L "$link" && "$(readlink "$link")" == "$script" ]]; then
        echo "jetson: PATH already set ($link -> $script)"
    else
        $elev ln -sfn "$script" "$link"
        echo "jetson: linked $link -> $script"
    fi

    _jetson_bootstrap_shell_env "$elev"
    echo "jetson: bootstrap complete (docker dir: $docker_dir, env file: $JETSON_ENV_FILE)"
}

# Install the guarded TFC env sourcing for every user: /etc/bash.bashrc covers
# interactive terminals, /etc/profile.d covers login/SSH shells. Idempotent.
_jetson_bootstrap_shell_env() {
    local elev="$1"
    local line="[ -f /opt/tfc-autonomous/config/tfc_paths.env ] && . /opt/tfc-autonomous/config/tfc_paths.env"
    local bashrc=/etc/bash.bashrc
    if $elev grep -qF -- "$line" "$bashrc" 2>/dev/null; then
        echo "jetson: $bashrc already sources the TFC env"
    else
        $elev sh -c 'printf "\n# tfc-autonomous env (managed by jetson bootstrap)\n%s\n" "$1" >> "$2"' _ "$line" "$bashrc"
        echo "jetson: added TFC env sourcing to $bashrc"
    fi
    local profiled=/etc/profile.d/tfc-autonomous-env.sh
    if $elev test -f "$profiled"; then
        echo "jetson: $profiled already sources the TFC env"
    else
        $elev sh -c 'printf "#!/bin/sh\n# generated by jetson bootstrap\n%s\n" "$1" > "$2" && chmod 644 "$2"' _ "$line" "$profiled"
        echo "jetson: created $profiled"
    fi
}

_jetson_docker_help() {
    cat <<EOF
jetson docker <subcommand>

Subcommands:
  build       build the image from this repo's Dockerfile
  up          create/start the container (compose up -d)
  up --build  build then start
  stop        stop the container (kept, restartable)
  down        stop and remove the container
  rm          force-remove the container
  enter       enter the container with X11 forwarding
  ps          show container status
  logs        tail the container logs
EOF
}

_jetson_help() {
    cat <<'EOF'
jetson - tfc-autonomous Jetson container CLI

Usage:
  jetson [--member <path>] docker <subcommand>
  jetson [--member <path>] env
  jetson bootstrap
  jetson help

Commands:
  bootstrap   link jetson onto the system PATH and install the TFC env sourcing
              for every user (idempotent; re-run after setup_jetson.py changes)
EOF
    _jetson_docker_help
}

jetson() {
    local member=""
    local args=()
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --member|-m)
                member="${2:?--member requires a path}"
                shift 2
                ;;
            *)
                args+=("$1")
                shift
                ;;
        esac
    done
    if [[ -n "$member" ]]; then
        export JETSON_MEMBER_ENV="$member"
    fi

    local cmd="${args[0]:-help}"
    case "$cmd" in
        docker)
            local sub="${args[1]:-help}"
            case "$sub" in
                build)  jetson_docker_build "${args[@]:2}" ;;
                up)     jetson_docker_up "${args[@]:2}" ;;
                stop)   jetson_docker_stop "${args[@]:2}" ;;
                down)   jetson_docker_down "${args[@]:2}" ;;
                rm)     jetson_docker_rm "${args[@]:2}" ;;
                enter)  jetson_docker_enter "${args[@]:2}" ;;
                ps)     jetson_docker_ps "${args[@]:2}" ;;
                logs)   jetson_docker_logs "${args[@]:2}" ;;
                help)   _jetson_docker_help ;;
                *)      _jetson_docker_help >&2; return 1 ;;
            esac
            ;;
        env)
            jetson_env
            ;;
        bootstrap)
            jetson_bootstrap "${args[@]:1}"
            ;;
        help)
            _jetson_help
            ;;
        *)
            _jetson_help >&2
            return 1
            ;;
    esac
}

if [[ "${BASH_SOURCE[0]}" == "$0" ]]; then
    jetson "$@"
fi